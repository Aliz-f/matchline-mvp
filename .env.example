# Copy this file to .env.local. Leave blank for reliable offline mock AI.
# For a short local-only hackathon demo you can paste an OpenRouter key here.
# IMPORTANT: VITE_ variables are EMBEDDED IN CLIENT JS and are NOT secrets.
# Never commit an actual key; revoke the key after the demo.
VITE_OPENROUTER_API_KEY=
# Set a supported model slug from https://openrouter.ai/models
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
# Force a consistent, working offline demonstration even when the key is set.
VITE_AI_MODE=mock
